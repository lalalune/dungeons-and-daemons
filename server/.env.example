# Database — set DATABASE_URL or individual DB_ vars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eliza_dungeons
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eliza_dungeons
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Optional: campaign to auto-load (omit to use first active campaign)
# CAMPAIGN_ID=

# Optional: OpenAI for image generation
# OPENAI_API_KEY=
# FAL_API_KEY=

# Dungeon Master narration through your Claude subscription (development only).
# Create the token with `claude setup-token`, then paste it here.
# CLAUDE_CODE_OAUTH_TOKEN=
# DM_PROVIDER=claude-code   # force this path and use the machine's existing Claude login
# DM_MODEL=claude-opus-5-5

# Public repository of the code this server runs (AGPL-3.0 asks you to offer it to players)
# SOURCE_URL=https://github.com/you/your-fork
# Private deployments: ask visitors for this code before anything loads
# ACCESS_CODE=
